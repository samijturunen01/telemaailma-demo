# Hades Design – Telemaailma demo configuration (copy to .env for local overrides)

# Base path. GitHub Pages demo: /telemaailma-demo/   Production domain: /
VITE_BASE_PATH=/telemaailma-demo/
SITE_URL=https://samijturunen01.github.io/telemaailma-demo/

# Form transport. "demo" never sends anything. "apps-script" is prepared for
# production but MUST NOT be enabled before customer approval.
VITE_FORM_MODE=demo
# Google Apps Script web-app endpoint (production only)
VITE_APPS_SCRIPT_URL=
# Google reCAPTCHA v3 *site* key (public). The secret key belongs ONLY in the
# Apps Script backend, which must verify the token server-side.
VITE_RECAPTCHA_SITE_KEY=

# Search engine indexing. Keep "false" for the demo.
VITE_ALLOW_INDEXING=false
